# With nothing configured, every value comes from the embedded defaults and says
# so. "card" appearing with no origin would be the failure.
exec country-map-svg-generator explain --iso FR
stdout 'FR — France'
stdout 'profile\s+card\s+embedded defaults'
stdout 'boundary\s+un\s+embedded defaults'
stdout 'geometry request: preset card, boundary profile un'
stdout 'output: FR.svg'
! stderr .

# The full chain, with a different layer winning each key. This is the assertion
# that would break if the precedence order were ever reshuffled.
exec country-map-svg-generator explain --iso US --config config.yaml
stdout 'profile\s+hero\s+country override US'
stdout 'boundary\s+de_facto\s+country override US'
stdout 'style\s+filled\s+preset ancestry standalone-default'
stdout 'tokens.lineCap\s+round\s+preset ancestry site-default'
stdout 'marker.mode\s+none\s+embedded defaults'

# The geometry request is reported because the two axes cross on the way in:
# the configuration's profile is geometry's preset, and its boundary is
# geometry's profile. Transposed, everything downstream still passes.
stdout 'geometry request: preset hero, boundary profile de_facto, layout contain 720x420, budget 8000 bytes'

# A flag is the strongest layer.
exec country-map-svg-generator explain --iso US --config config.yaml --profile card
stdout 'profile\s+card\s+command-line flags'

exec country-map-svg-generator explain --iso FR --json
stdout '"iso": "FR"'
stdout '"layer": "embedded defaults"'
stdout '"geometry_request"'
stdout '"preset": "card"'
stdout '"profile": "un"'
stdout '"max_path_bytes": 2500'

-- config.yaml --
schema: country-map/v1
extends: standalone-default
profile: card
countries:
  US:
    profile: hero
    boundary: de_facto
    layout: { mode: contain, width: 720, height: 420 }
