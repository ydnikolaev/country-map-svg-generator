# An unexpected positional argument is a usage failure, not a silent success.
# schema takes no arguments: a caller passing one has misread the surface, which
# is exactly the mistake this command exists to prevent.
! exec country-map-svg-generator schema keys
stderr 'usage: expected 0 argument\(s\), got 1'
stderr 'usage: country-map-svg-generator schema'
! stdout .

# An unknown flag is the same class, reported through the same channel.
! exec country-map-svg-generator schema --nope
stderr 'usage: unknown flag: --nope'
! stdout .
