# VAL-6: a failure anywhere in the batch leaves the previous output exactly as it
# was. The first run establishes a good output; the second asks for something
# that cannot be produced and must change nothing.
exec country-map-svg-generator generate --iso FR --out assets
cp assets/FR.svg good.svg
cp assets/country-map.manifest.json good.json

# A standalone asset with a variable that has no fallback cannot be produced: it
# would render as nothing, which reads as a broken file rather than as a
# configuration mistake.
! exec country-map-svg-generator generate --config broken.yaml --iso FR --out assets
stderr 'themed-inline'
cmp assets/FR.svg good.svg
cmp assets/country-map.manifest.json good.json

# An unknown entity fails before anything is staged.
! exec country-map-svg-generator generate --iso ZZ --out assets
stderr 'data: no entity "ZZ"'
cmp assets/FR.svg good.svg

# A configuration that resolves every entity to one path is refused before any
# of them is written, naming the claimants.
! exec country-map-svg-generator generate --config collide.yaml --out assets
stderr 'is the output path for'
cmp assets/FR.svg good.svg
cmp assets/country-map.manifest.json good.json

! exec country-map-svg-generator generate extra
stderr 'usage: expected 0 argument\(s\), got 1'

-- broken.yaml --
schema: country-map/v1
delivery: standalone
tokens:
  fill: var(--brand)
-- collide.yaml --
schema: country-map/v1
output:
  filename: "map.svg"
